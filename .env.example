# MeshTracker settings. Copy to ".env" and adjust:  cp .env.example .env
# Anything missing here uses its default value (see the README).

# --- Web interface ---------------------------------------------------------------
# Port on which the page is reachable on the server: http://<server>:8282
MT_WEB_PORT=8282

# --- Connection to the MeshCore companion ----------------------------------------
# tcp    = WiFi companion firmware OR MeshMonitor's "Virtual Node"
# serial = companion over USB (additionally use docker-compose.serial.yml, see README)
# sim    = simulator (demo without radio hardware)
MT_TRANSPORT=tcp

# For tcp: IP address (not "localhost"!) and port.
#   MeshMonitor Virtual Node:  IP of the MeshMonitor machine + port of the Virtual Node
#   WiFi companion directly:   IP of the device + port 5000
MT_HOST=192.168.1.50
MT_PORT=5000

# For serial:
# MT_SERIAL_PORT=/dev/ttyACM0
# MT_SERIAL_BAUD=115200

# --- Password protection (recommended if the page is reachable beyond your home network) ---
# MT_AUTH_USER=admin
# MT_AUTH_PASSWORD=change-me

# --- Map -------------------------------------------------------------------------
# Default: OpenStreetMap. To use your own tiles enter them here (keep {z}/{x}/{y}).
# MT_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MT_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# MT_TILE_MAX_ZOOM=19

# --- Fine tuning (the defaults are usually fine) ----------------------------------
# MT_FLOOD_RETRIES=2     # flood retries when a request got no reply
# MT_PATH_TIMEOUT=48     # minimum wait per attempt in seconds (10 is enough when connected directly)
# MT_FLOOD_TIMEOUT=48    # same for flood attempts (25 is enough when connected directly)
# MT_FLOOD_BACKOFF=5     # pause between flood retries (s)
# MT_MIN_SPACING=10      # minimum gap between two radio requests (s)
# MT_FAIL_RETRY=180      # retry sooner after a failed round (s)
# MT_ADVERT_SYNC=60     # how often the node's contact list is checked for new advert positions (s)
# MT_LOG_LEVEL=INFO
