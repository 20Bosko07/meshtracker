# MeshTracker – Einstellungen. Kopieren nach ".env" und anpassen:  cp .env.example .env
# Alles, was hier fehlt, nimmt den Standardwert (siehe README).

# --- Weboberfläche -------------------------------------------------------------
# Port, unter dem die Seite auf dem Server erreichbar ist: http://<server>:8282
MT_WEB_PORT=8282

# --- Verbindung zum MeshCore-Companion --------------------------------------------
# tcp    = WiFi-Companion-Firmware ODER der "Virtual Node" von MeshMonitor
# serial = Companion per USB (zusätzlich docker-compose.serial.yml verwenden, siehe README)
# sim    = Simulator (Demo ohne Funkhardware)
MT_TRANSPORT=tcp

# Bei tcp: IP-Adresse (nicht "localhost"!) und Port.
#   MeshMonitor Virtual Node:  IP des MeshMonitor-Rechners + Port des Virtual Node
#   WiFi-Companion direkt:     IP des Geräts + Port 5000
MT_HOST=192.168.1.50
MT_PORT=5000

# Bei serial:
# MT_SERIAL_PORT=/dev/ttyACM0
# MT_SERIAL_BAUD=115200

# --- Passwortschutz (empfohlen, wenn die Seite über das Heimnetz hinaus erreichbar ist) ---
# MT_AUTH_USER=admin
# MT_AUTH_PASSWORD=bitte-aendern

# --- Karte ---------------------------------------------------------------------------
# Standard: OpenStreetMap. Für eigene Kacheln hier eintragen ({z}/{x}/{y} bleiben stehen).
# MT_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MT_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# MT_TILE_MAX_ZOOM=19

# --- Feintuning (Standardwerte passen meistens) -----------------------------------------
# MT_FLOOD_RETRIES=2     # Flood-Wiederholungen, wenn eine Anfrage unbeantwortet bleibt
# MT_PATH_TIMEOUT=48     # Mindest-Wartezeit je Versuch in Sekunden (direkt am Node reichen 10)
# MT_FLOOD_TIMEOUT=48    # dito für Flood-Versuche (direkt am Node reichen 25)
# MT_FLOOD_BACKOFF=5     # Pause zwischen Flood-Wiederholungen (s)
# MT_MIN_SPACING=10      # Mindestabstand zwischen zwei Funk-Anfragen (s)
# MT_FAIL_RETRY=180      # nach Fehlschlag früher erneut versuchen (s)
# MT_LOG_LEVEL=INFO
